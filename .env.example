# Database Connection (PostgreSQL with pgvector)
# Matches docker-compose.yml defaults
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ai_learning_support

# Supabase Auth Configuration
# Local Supabase CLI defaults or your Supabase Cloud project credentials
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6IjEyNy4wLjAuMSIsInJvbGUiOiJhbm9uIiwiaWF0IjoxNjAwMDAwMDAwLCJleHAiOjIwMDAwMDAwMDB9.dummy_anon_key
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Fast Local Development Auth Mode
# Set to 'true' to enable instant local mock authentication without needing a Supabase GoTrue container
LOCAL_DEV_AUTH=true

# AI Provider API Keys (Multi-LLM & BYOK Support)
# If no keys are provided, the app falls back to a built-in mock AI streaming responder
GOOGLE_GENERATIVE_AI_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
