{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "project": [
    "app/**/*.{ts,tsx}",
    "components/**/*.{ts,tsx}",
    "lib/**/*.{ts,tsx}",
    "tests/**/*.{ts,tsx}",
    "scripts/**/*.{ts,js}"
  ],
  "ignore": ["components/ui/**"],
  "ignoreExportsUsedInFile": true,
  "ignoreDependencies": [
    "@ai-sdk/anthropic",
    "@tailwindcss/typography",
    "pg-boss",
    "tailwindcss",
    "tailwindcss-animate",
    "agent-browser"
  ]
}
