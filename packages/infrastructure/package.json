{
  "name": "@ai-learning-support/infrastructure",
  "version": "1.0.0",
  "private": true,
  "description": "Database ORM schemas, repositories, and storage adapters",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "dev": "tsup src/index.ts --format esm,cjs --dts --watch",
    "build": "tsup src/index.ts --format esm,cjs --dts",
    "lint": "biome lint src",
    "format": "biome format src --write",
    "typecheck": "tsc --noEmit",
    "test": "DATABASE_PATH=../../.data/app.infra.test.db vitest run --project=infrastructure"
  },
  "type": "module",
  "devDependencies": {
    "@ai-learning-support/tsconfig": "workspace:*",
    "@types/better-sqlite3": "^7.6.13",
    "tsup": "^8.3.5"
  },
  "dependencies": {
    "@ai-learning-support/shared": "workspace:*",
    "better-sqlite3": "^11.8.0",
    "drizzle-orm": "^0.38.3"
  }
}
